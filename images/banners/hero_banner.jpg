<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <!-- Background Gradient -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0284c7" />
      <stop offset="45%" stop-color="#2563eb" />
      <stop offset="100%" stop-color="#1d4ed8" />
    </linearGradient>

    <!-- Glass / Light Glare Gradient -->
    <linearGradient id="glareGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.35" />
      <stop offset="50%" stop-color="#ffffff" stop-opacity="0.05" />
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
    </linearGradient>

    <!-- Neon Emblem Glow Gradient -->
    <linearGradient id="bagGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="60%" stop-color="#e0f2fe" />
      <stop offset="100%" stop-color="#38bdf8" />
    </linearGradient>

    <!-- Shadow Filter -->
    <filter id="dropShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="16" stdDeviation="24" flood-color="#0f172a" flood-opacity="0.25" />
    </filter>

    <filter id="iconGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="4" stdDeviation="8" flood-color="#38bdf8" flood-opacity="0.5" />
    </filter>
  </defs>

  <!-- Outer Shadow & Squircle Body -->
  <rect x="32" y="32" width="448" height="448" rx="108" fill="url(#bgGrad)" filter="url(#dropShadow)" />

  <!-- Top Glass Highlight Sheen -->
  <path d="M32 140 C 32 80, 80 32, 140 32 L 372 32 C 432 32, 480 80, 480 140 C 480 200, 32 260, 32 140 Z" fill="url(#glareGrad)" />

  <!-- Shopping Bag Handle -->
  <path d="M 206 195 V 160 C 206 132 228 110 256 110 C 284 110 306 132 306 160 V 195" 
        fill="none" 
        stroke="url(#bagGrad)" 
        stroke-width="26" 
        stroke-linecap="round" 
        filter="url(#iconGlow)" />

  <!-- Shopping Bag Body with Speed/Lightning Notch -->
  <path d="M 175 195 L 150 375 C 148 392, 161 405, 178 405 L 334 405 C 351 405, 364 392, 362 375 L 337 195 C 335 186, 328 180, 319 180 L 193 180 C 184 180, 177 186, 175 195 Z" 
        fill="url(#bagGrad)" 
        filter="url(#iconGlow)" />

  <!-- Dynamic Electric / Swift Slash Accent -->
  <path d="M 120 305 L 255 240 L 225 295 L 380 215 L 235 345 L 265 295 Z" 
        fill="#ffffff" 
        opacity="0.95" />
</svg>

