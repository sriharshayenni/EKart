# ==============================================================================
# eKart - Environment Configuration
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or local MongoDB instance)
# e.g., mongodb://localhost:27017/ekart or mongodb+srv://<user>:<password>@cluster.mongodb.net/ekart
MONGODB_URI=mongodb://127.0.0.1:27017/ekart

# Session Configuration
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_characters
SESSION_NAME=ekart.sid
SESSION_MAX_AGE=86400000

# Password Security (Work factor for bcrypt hashing)
BCRYPT_ROUNDS=12

# Optional Client URL & App Branding
CLIENT_URL=http://localhost:5000
APP_NAME=eKart
