  <!-- Site Footer -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        
        <!-- About Column -->
        <div>
          <div class="footer-brand">
            <a href="/" class="brand-logo">
              <div class="logo-icon">
                <i class="fa-solid fa-bag-shopping"></i>
              </div>
              <span>e<span class="accent">Kart</span></span>
            </a>
          </div>
          <p class="footer-desc">
            eKart is an all-in-one commercial shopping platform built to bring you the finest electronic gadgets, premium fashion, home appliances, and daily essentials with ultra-fast delivery and verified customer trust.
          </p>
          <div style="display: flex; gap: 1rem; font-size: 1.25rem;">
            <a href="#" style="color: #94a3b8;"><i class="fa-brands fa-facebook"></i></a>
            <a href="#" style="color: #94a3b8;"><i class="fa-brands fa-x-twitter"></i></a>
            <a href="#" style="color: #94a3b8;"><i class="fa-brands fa-instagram"></i></a>
            <a href="#" style="color: #94a3b8;"><i class="fa-brands fa-youtube"></i></a>
          </div>
        </div>

        <!-- Quick Links -->
        <div>
          <h4 class="footer-col-title">Explore eKart</h4>
          <ul class="footer-links">
            <li><a href="/products">All Collections</a></li>
            <li><a href="/products?sort=discount">Deals &amp; Offers</a></li>
            <li><a href="/products?sort=newest">New Arrivals</a></li>
            <li><a href="/products?category=smartphones-electronics">Smartphones</a></li>
            <li><a href="/products?category=laptops-accessories">Laptops &amp; PCs</a></li>
            <li><a href="/products?category=fashion-clothing">Fashion Trends</a></li>
          </ul>
        </div>

        <!-- Support & Policies -->
        <div>
          <h4 class="footer-col-title">Customer Care</h4>
          <ul class="footer-links">
            <li><a href="/account">My Account</a></li>
            <li><a href="/orders">Track Your Order</a></li>
            <li><a href="/wishlist">Wishlist</a></li>
            <li><a href="/faq">Help Center &amp; FAQs</a></li>
            <li><a href="/contact">Contact Support</a></li>
            <li><a href="/privacy">Privacy Policy</a></li>
            <li><a href="/terms">Terms of Service</a></li>
          </ul>
        </div>

        <!-- Newsletter Column -->
        <div>
          <h4 class="footer-col-title">Stay in the Loop</h4>
          <p style="font-size: 0.875rem; margin-bottom: 0.75rem; line-height: 1.5;">
            Subscribe to our weekly VIP newsletter for exclusive flash sale codes and early access to drops.
          </p>
          <form class="newsletter-form">
            <input 
              type="email" 
              class="newsletter-input" 
              placeholder="Enter your email address..." 
              required
            >
            <button type="submit" class="btn btn-primary" style="padding: 0.65rem 1rem;">
              <i class="fa-solid fa-paper-plane"></i>
            </button>
          </form>
          <div style="margin-top: 1.25rem; font-size: 0.8125rem; color: #64748b;">
            <i class="fa-solid fa-shield-halved" style="color: #38bdf8; margin-right: 4px;"></i> 100% Secure Checkout &amp; Data Privacy
          </div>
        </div>

      </div>

      <!-- Footer Bottom -->
      <div class="footer-bottom">
        <div>
          &copy; <%= new Date().getFullYear() %> eKart Online Technologies Pvt. Ltd. All rights reserved.
        </div>
        <div style="display: flex; gap: 1.25rem; align-items: center; font-size: 1.5rem; color: #64748b;">
          <i class="fa-brands fa-cc-visa" title="Visa"></i>
          <i class="fa-brands fa-cc-mastercard" title="Mastercard"></i>
          <i class="fa-brands fa-google-pay" title="UPI & Google Pay"></i>
          <i class="fa-brands fa-apple-pay" title="Apple Pay"></i>
        </div>
      </div>
    </div>
  </footer>

  <!-- Toast Container -->
  <div id="toast-container">
    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
      <div class="toast toast-success">
        <span><%= successMessage %></span>
        <button style="background:none; border:none; color:inherit; cursor:pointer; font-size:1.1rem; padding:0 4px;" onclick="this.parentElement.remove()">&times;</button>
      </div>
    <% } %>
    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div class="toast toast-error">
        <span><%= errorMessage %></span>
        <button style="background:none; border:none; color:inherit; cursor:pointer; font-size:1.1rem; padding:0 4px;" onclick="this.parentElement.remove()">&times;</button>
      </div>
    <% } %>
  </div>

  <!-- Client JavaScript -->
  <script src="/js/main.js"></script>
  <script src="/js/cart.js"></script>
  <script src="/js/product.js"></script>
</body>
</html>
