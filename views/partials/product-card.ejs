<div class="product-card">
  <!-- Badges -->
  <div class="product-badge-wrap">
    <% if (product.discountPercentage && product.discountPercentage > 0) { %>
      <span class="badge-discount">-<%= product.discountPercentage %>% OFF</span>
    <% } %>
    <% if (product.isNewArrival) { %>
      <span class="badge-new">NEW</span>
    <% } %>
  </div>

  <!-- Wishlist Toggle -->
  <% 
    let isWishlisted = false;
    if (typeof currentUser !== 'undefined' && currentUser && currentUser.wishlist) {
      isWishlisted = currentUser.wishlist.some(id => id.toString() === product._id.toString());
    }
  %>
  <button 
    class="product-wishlist-btn btn-wishlist-toggle <%= isWishlisted ? 'active' : '' %>" 
    data-product-id="<%= product._id %>"
    title="<%= isWishlisted ? 'Remove from Wishlist' : 'Add to Wishlist' %>"
    style="<%= isWishlisted ? 'color: #ef4444;' : '' %>"
  >
    <i class="<%= isWishlisted ? 'fa-solid' : 'fa-regular' %> fa-heart"></i>
  </button>

  <!-- Product Image -->
  <a href="/products/<%= product.slug %>" class="product-img-box">
    <img 
      src="<%= (product.images && product.images.length > 0) ? product.images[0] : '/images/placeholder.svg' %>" 
      alt="<%= product.name %>" 
      loading="lazy"
      onerror="this.onerror=null; this.src='/images/placeholder.svg';"
    >
  </a>

  <!-- Product Details -->
  <div class="product-info">
    <div class="product-category-meta">
      <%= product.category && product.category.name ? product.category.name : (product.brand || 'eKart Choice') %>
    </div>

    <h3 class="product-title">
      <a href="/products/<%= product.slug %>"><%= product.name %></a>
    </h3>

    <!-- Rating -->
    <div class="rating-bar">
      <div class="rating-stars">
        <% const avgRating = Math.round(product.rating ? product.rating.average : 5); %>
        <% for(let i = 1; i <= 5; i++) { %>
          <i class="<%= i <= avgRating ? 'fa-solid' : 'fa-regular' %> fa-star"></i>
        <% } %>
      </div>
      <span class="rating-count">(<%= product.rating ? product.rating.count : 0 %>)</span>
    </div>

    <!-- Pricing -->
    <div class="product-pricing">
      <span class="current-price">₹<%= product.price.toLocaleString() %></span>
      <% if (product.originalPrice && product.originalPrice > product.price) { %>
        <span class="original-price">₹<%= product.originalPrice.toLocaleString() %></span>
      <% } %>
    </div>

    <!-- Action Buttons -->
    <div class="card-actions">
      <% if (product.stock > 0) { %>
        <button 
          class="btn-add-cart btn-add-cart-ajax" 
          data-product-id="<%= product._id %>"
        >
          <i class="fa-solid fa-cart-shopping"></i> Add to Cart
        </button>
      <% } else { %>
        <button class="btn-add-cart" disabled style="background-color: var(--bg-muted); color: var(--text-muted); cursor: not-allowed;">
          Out of Stock
        </button>
      <% } %>
    </div>
  </div>
</div>
