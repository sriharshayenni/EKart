<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/admin.css">

<div class="admin-layout">
  <%- include('sidebar') %>

  <main class="admin-main">
    <div class="admin-header">
      <div>
        <h1 class="admin-title">Product Catalog</h1>
        <p style="font-size: 0.875rem; color: var(--text-muted); margin-top: 0.25rem;">
          Manage listings, stock levels, pricing, and visual assets
        </p>
      </div>

      <a href="/admin/products/new" class="btn btn-primary">
        <i class="fa-solid fa-plus"></i> Add New Product
      </a>
    </div>

    <!-- Filter & Search Controls -->
    <div class="admin-card" style="padding: 1.25rem 1.5rem; margin-bottom: 1.5rem;">
      <form action="/admin/products" method="GET" style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 240px;">
          <input 
            type="text" 
            name="search" 
            class="form-control" 
            placeholder="Search by product title or brand..." 
            value="<%= query.search || '' %>"
          >
        </div>

        <div style="min-width: 200px;">
          <select name="category" class="form-control" onchange="this.form.submit()">
            <option value="all">All Categories</option>
            <% categories.forEach(cat => { %>
              <option value="<%= cat._id %>" <%= query.category === cat._id.toString() ? 'selected' : '' %>>
                <%= cat.name %>
              </option>
            <% }) %>
          </select>
        </div>

        <button type="submit" class="btn btn-outline">Filter</button>
        <% if (query.search || (query.category && query.category !== 'all')) { %>
          <a href="/admin/products" class="btn btn-sm" style="color: var(--accent-rose);">Reset</a>
        <% } %>
      </form>
    </div>

    <!-- Products Table -->
    <div class="admin-card">
      <div class="admin-card-header">
        <div class="admin-card-title">All Products (<%= totalProducts %> total)</div>
      </div>

      <div class="table-responsive">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Image</th>
              <th>Product Details</th>
              <th>Category</th>
              <th>Price</th>
              <th>Stock</th>
              <th>Status</th>
              <th style="text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (products && products.length > 0) { %>
              <% products.forEach(prod => { %>
                <tr>
                  <td>
                    <img 
                      src="<%= (prod.images && prod.images.length > 0) ? prod.images[0] : '/images/placeholder.svg' %>" 
                      alt="<%= prod.name %>" 
                      class="admin-thumb"
                      onerror="this.onerror=null; this.src='/images/placeholder.svg';"
                    >
                  </td>
                  <td>
                    <div style="font-weight: 700; color: var(--secondary); margin-bottom: 2px;">
                      <%= prod.name %>
                    </div>
                    <div style="font-size: 0.75rem; color: var(--text-muted);">
                      Slug: <%= prod.slug %> | Brand: <%= prod.brand || 'N/A' %>
                    </div>
                  </td>
                  <td><%= prod.category ? prod.category.name : 'Uncategorized' %></td>
                  <td style="font-weight: 700; color: var(--secondary);">
                    ₹<%= prod.price.toLocaleString() %>
                    <% if (prod.originalPrice > prod.price) { %>
                      <div style="font-size: 0.75rem; color: var(--text-muted); text-decoration: line-through;">
                        ₹<%= prod.originalPrice.toLocaleString() %>
                      </div>
                    <% } %>
                  </td>
                  <td>
                    <span style="font-weight: 700; color: <%= prod.stock > 5 ? 'var(--secondary)' : 'var(--accent-rose)' %>;">
                      <%= prod.stock %>
                    </span>
                  </td>
                  <td>
                    <span class="status-badge <%= prod.active ? 'status-delivered' : 'status-cancelled' %>">
                      <%= prod.active ? 'Active' : 'Disabled' %>
                    </span>
                  </td>
                  <td style="text-align: right;">
                    <div class="action-buttons" style="justify-content: flex-end;">
                      <a href="/products/<%= prod.slug %>" target="_blank" class="btn btn-outline btn-sm" title="View in Store">
                        <i class="fa-solid fa-arrow-up-right-from-square"></i>
                      </a>
                      <a href="/admin/products/<%= prod._id %>/edit" class="btn btn-primary btn-sm" title="Edit Product">
                        <i class="fa-solid fa-pen-to-square"></i>
                      </a>
                      <form action="/admin/products/<%= prod._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to permanently delete this product?');">
                        <button type="submit" class="btn btn-danger btn-sm" title="Delete">
                          <i class="fa-solid fa-trash-can"></i>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="7" style="text-align: center; color: var(--text-muted); padding: 3rem;">
                  No products found. Add your first product to begin!
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <% if (totalPages > 1) { %>
        <div style="padding: 1.25rem; display: flex; justify-content: center;">
          <div class="pagination" style="margin: 0;">
            <% for(let p = 1; p <= totalPages; p++) { %>
              <a 
                href="/admin/products?<%= new URLSearchParams({...query, page: p}).toString() %>" 
                class="page-link <%= p === currentPage ? 'active' : '' %>"
              >
                <%= p %>
              </a>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>
