<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container" style="padding-top: 3rem; padding-bottom: 5rem;">
  <div style="max-width: 800px; margin: 0 auto;">
    
    <div style="text-align: center; margin-bottom: 3rem;">
      <h1 style="font-size: 2.25rem; font-weight: 800; color: var(--secondary); margin-bottom: 0.75rem;">
        Privacy Policy
      </h1>
      <p style="font-size: 0.95rem; color: var(--text-muted);">
        Effective Date: <%= new Date().toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' }) %>
      </p>
    </div>

    <div class="card" style="padding: 2.5rem; line-height: 1.8; color: var(--text-main);">
      <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--secondary); margin-bottom: 0.75rem;">
        1. Information We Collect
      </h3>
      <p style="margin-bottom: 1.5rem;">
        We collect personal credentials necessary to service your shopping experience, including your name, email address, contact telephone, delivery addresses, and purchasing preferences. We never store raw payment credit card numbers on our servers.
      </p>

      <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--secondary); margin-bottom: 0.75rem;">
        2. How We Safeguard Your Data
      </h3>
      <p style="margin-bottom: 1.5rem;">
        All user passwords are encrypted using bcrypt hashing with salted work factors before being saved into our persistent MongoDB database. Server communications are safeguarded using TLS encryption, HTTP-only cookie security, and Helmet security headers.
      </p>

      <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--secondary); margin-bottom: 0.75rem;">
        3. Cookies and Stateful Sessions
      </h3>
      <p>
        eKart uses secure, server-side session cookies to authenticate logged-in customers and remember shopping carts across page transitions. These cookies are marked HttpOnly and are protected against session fixation vulnerabilities.
      </p>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
