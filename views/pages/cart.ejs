<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container" style="padding-top: 2rem; padding-bottom: 4rem;">

  <h1 style="font-size: 1.85rem; font-weight: 800; color: var(--secondary); margin-bottom: 1.5rem;">
    Shopping Cart (<%= cart && cart.items ? cart.items.length : 0 %> <%= cart && cart.items && cart.items.length === 1 ? 'item' : 'items' %>)
  </h1>

  <% if (cart && cart.items && cart.items.length > 0) { %>
    <div class="cart-grid" style="display: grid; grid-template-columns: 1fr 360px; gap: 2rem; align-items: start;">
      
      <!-- Cart Items Table / List -->
      <div class="card" style="padding: 0; overflow: hidden;">
        <div class="table-responsive">
          <table class="cart-items-table admin-table">
            <thead>
              <tr>
                <th style="width: 45%;">Product</th>
                <th>Price</th>
                <th style="text-align: center;">Quantity</th>
                <th style="text-align: right;">Subtotal</th>
                <th style="text-align: center;">Action</th>
              </tr>
            </thead>
            <tbody>
              <% cart.items.forEach(item => { %>
                <% if (item.product) { %>
                  <tr id="cart-row-<%= item._id %>">
                    <!-- Product Info -->
                    <td>
                      <div style="display: flex; align-items: center; gap: 1rem;">
                        <img 
                          src="<%= (item.product.images && item.product.images.length > 0) ? item.product.images[0] : '/images/placeholder.svg' %>" 
                          alt="<%= item.product.name %>" 
                          class="admin-thumb"
                          style="width: 3.5rem; height: 3.5rem;"
                          onerror="this.onerror=null; this.src='/images/placeholder.svg';"
                        >
                        <div>
                          <a href="/products/<%= item.product.slug %>" style="font-weight: 600; color: var(--secondary);">
                            <%= item.product.name %>
                          </a>
                          <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 2px;">
                            <%= item.product.brand || (item.product.category ? item.product.category.name : '') %>
                          </div>
                        </div>
                      </div>
                    </td>

                    <!-- Price -->
                    <td style="font-weight: 600; color: var(--secondary);">
                      ₹<%= item.product.price.toLocaleString() %>
                    </td>

                    <!-- Quantity Stepper -->
                    <td style="text-align: center;">
                      <div style="display: inline-flex; align-items: center; border: 1px solid var(--border-light); border-radius: var(--radius-sm); background: white; overflow: hidden;">
                        <button 
                          type="button" 
                          class="btn-qty-update" 
                          data-action="decrease" 
                          data-item-id="<%= item._id %>"
                          style="width: 1.85rem; height: 1.85rem; border: none; background: #f8fafc; cursor: pointer; font-weight: 700;"
                        >-</button>
                        <input 
                          type="number" 
                          id="qty-<%= item._id %>" 
                          class="cart-qty-input"
                          data-item-id="<%= item._id %>" 
                          value="<%= item.quantity %>" 
                          min="1" 
                          max="<%= item.product.stock %>"
                          style="width: 2.25rem; text-align: center; border: none; font-weight: 700; font-size: 0.875rem; outline: none;"
                        >
                        <button 
                          type="button" 
                          class="btn-qty-update" 
                          data-action="increase" 
                          data-item-id="<%= item._id %>"
                          style="width: 1.85rem; height: 1.85rem; border: none; background: #f8fafc; cursor: pointer; font-weight: 700;"
                        >+</button>
                      </div>
                    </td>

                    <!-- Line Subtotal -->
                    <td style="text-align: right; font-weight: 700; color: var(--primary);" id="subtotal-<%= item._id %>">
                      ₹<%= (item.product.price * item.quantity).toLocaleString() %>
                    </td>

                    <!-- Remove Item -->
                    <td style="text-align: center;">
                      <button 
                        class="btn-remove-item" 
                        data-item-id="<%= item._id %>" 
                        title="Remove item" 
                        style="background: none; border: none; color: #ef4444; cursor: pointer; font-size: 1rem; padding: 4px;"
                      >
                        <i class="fa-regular fa-trash-can"></i>
                      </button>
                    </td>
                  </tr>
                <% } %>
              <% }) %>
            </tbody>
          </table>
        </div>

        <!-- Cart Table Bottom Actions -->
        <div style="padding: 1.25rem 1.5rem; background: #f8fafc; border-top: 1px solid var(--border-light); display: flex; justify-content: space-between; align-items: center;">
          <a href="/products" class="btn btn-outline btn-sm">
            <i class="fa-solid fa-arrow-left"></i> Continue Shopping
          </a>
          <form action="/cart/clear" method="POST" onsubmit="return confirm('Are you sure you want to empty your entire cart?');">
            <button type="submit" class="btn btn-sm" style="color: var(--accent-rose); background: none; border: none; font-weight: 600; cursor: pointer;">
              <i class="fa-solid fa-trash-can"></i> Clear Cart
            </button>
          </form>
        </div>
      </div>

      <!-- Order Summary Card -->
      <aside class="card">
        <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--secondary); margin-bottom: 1.25rem;">
          Order Summary
        </h3>

        <!-- Free shipping indicator -->
        <% if (subtotal < 1000) { %>
          <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: var(--radius-md); padding: 0.75rem; font-size: 0.8125rem; color: #1e40af; margin-bottom: 1.25rem;">
            <i class="fa-solid fa-truck-fast"></i> Add <strong>₹<%= (1000 - subtotal).toLocaleString() %></strong> more to unlock <strong>FREE Shipping!</strong>
          </div>
        <% } else { %>
          <div style="background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: var(--radius-md); padding: 0.75rem; font-size: 0.8125rem; color: #065f46; margin-bottom: 1.25rem;">
            <i class="fa-solid fa-circle-check"></i> Congratulations! You've unlocked <strong>FREE Shipping</strong>.
          </div>
        <% } %>

        <div style="display: flex; flex-direction: column; gap: 0.85rem; font-size: 0.9375rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-light); padding-bottom: 1.25rem;">
          <div style="display: flex; justify-content: space-between; color: var(--text-muted);">
            <span>Bag Subtotal</span>
            <span style="font-weight: 600; color: var(--secondary);" id="summary-subtotal">₹<%= subtotal.toLocaleString() %></span>
          </div>
          <div style="display: flex; justify-content: space-between; color: var(--text-muted);">
            <span>Estimated Shipping</span>
            <span style="font-weight: 600; color: var(--secondary);" id="summary-shipping">
              <%= shippingFee === 0 ? 'FREE' : `₹${shippingFee}` %>
            </span>
          </div>
          <div style="display: flex; justify-content: space-between; color: var(--text-muted);">
            <span>Taxes &amp; GST (5%)</span>
            <span style="font-weight: 600; color: var(--secondary);" id="summary-tax">₹<%= tax.toLocaleString() %></span>
          </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: baseline; font-size: 1.25rem; font-weight: 800; color: var(--secondary); margin-bottom: 1.5rem;">
          <span>Grand Total</span>
          <span style="color: var(--primary);" id="summary-total">₹<%= total.toLocaleString() %></span>
        </div>

        <a href="/checkout" class="btn btn-primary btn-lg btn-block" style="box-shadow: var(--shadow-md);">
          <i class="fa-solid fa-lock"></i> Proceed to Checkout
        </a>

        <div style="margin-top: 1.25rem; text-align: center; font-size: 0.75rem; color: var(--text-muted);">
          <i class="fa-solid fa-shield-halved" style="color: var(--accent-emerald);"></i> 256-bit Bank Grade SSL Encryption
        </div>
      </aside>

    </div>

  <% } else { %>
    <!-- Empty Cart Page -->
    <div class="empty-state">
      <div class="empty-icon">
        <i class="fa-solid fa-cart-shopping"></i>
      </div>
      <h2 class="empty-title">Your shopping cart is empty</h2>
      <p class="empty-desc">
        Looks like you haven't added anything to your cart yet. Explore our latest electronics, fashion, and home products!
      </p>
      <a href="/products" class="btn btn-primary btn-lg">
        <i class="fa-solid fa-bag-shopping"></i> Start Shopping Now
      </a>
    </div>
  <% } %>

</main>

<%- include('../partials/footer') %>
