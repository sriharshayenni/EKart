<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container" style="padding-top: 3rem; padding-bottom: 5rem;">
  <div style="max-width: 960px; margin: 0 auto;">
    
    <div style="text-align: center; margin-bottom: 3rem;">
      <h1 style="font-size: 2.25rem; font-weight: 800; color: var(--secondary); margin-bottom: 0.75rem;">
        Get in Touch With Us
      </h1>
      <p style="font-size: 1.05rem; color: var(--text-muted);">
        Have questions regarding an order, product warranty, or partnership? We're here to help.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1.35fr; gap: 2.5rem; align-items: start;">
      
      <!-- Contact Information Card -->
      <div class="card" style="padding: 2rem;">
        <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--secondary); margin-bottom: 1.5rem;">
          Customer Support
        </h3>

        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
          <div style="display: flex; gap: 1rem; align-items: flex-start;">
            <div style="width: 2.5rem; height: 2.5rem; border-radius: var(--radius-md); background: var(--primary-light); color: var(--primary); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <i class="fa-solid fa-envelope"></i>
            </div>
            <div>
              <div style="font-weight: 700; color: var(--secondary);">Email Inquiries</div>
              <div style="color: var(--text-muted); font-size: 0.875rem;">support@ekart-shopping.com</div>
              <div style="color: var(--text-subtle); font-size: 0.75rem;">Response time: Within 4 business hours</div>
            </div>
          </div>

          <div style="display: flex; gap: 1rem; align-items: flex-start;">
            <div style="width: 2.5rem; height: 2.5rem; border-radius: var(--radius-md); background: var(--primary-light); color: var(--primary); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <i class="fa-solid fa-phone"></i>
            </div>
            <div>
              <div style="font-weight: 700; color: var(--secondary);">Toll-Free Helpline</div>
              <div style="color: var(--text-muted); font-size: 0.875rem;">1800-419-EKART (35278)</div>
              <div style="color: var(--text-subtle); font-size: 0.75rem;">Available Mon-Sat 9:00 AM - 9:00 PM IST</div>
            </div>
          </div>

          <div style="display: flex; gap: 1rem; align-items: flex-start;">
            <div style="width: 2.5rem; height: 2.5rem; border-radius: var(--radius-md); background: var(--primary-light); color: var(--primary); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <i class="fa-solid fa-building"></i>
            </div>
            <div>
              <div style="font-weight: 700; color: var(--secondary);">Corporate Office</div>
              <div style="color: var(--text-muted); font-size: 0.875rem;">
                eKart Towers, Tech Park Boulevard,<br>
                Outer Ring Road, Bengaluru, Karnataka, 560103
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form Card -->
      <div class="card" style="padding: 2rem;">
        <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--secondary); margin-bottom: 1.25rem;">
          Send Us a Message
        </h3>

        <form action="/contact" method="POST">
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="form-group">
              <label class="form-label" for="name">Your Name *</label>
              <input 
                type="text" 
                id="name" 
                name="name" 
                class="form-control" 
                value="<%= typeof name !== 'undefined' ? name : (currentUser ? currentUser.name : '') %>" 
                required
              >
            </div>

            <div class="form-group">
              <label class="form-label" for="email">Email Address *</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                class="form-control" 
                value="<%= typeof email !== 'undefined' ? email : (currentUser ? currentUser.email : '') %>" 
                required
              >
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="subject">Subject *</label>
            <input 
              type="text" 
              id="subject" 
              name="subject" 
              class="form-control" 
              placeholder="e.g. Question about order tracking, warranty claim" 
              value="<%= typeof subject !== 'undefined' ? subject : '' %>"
              required
            >
          </div>

          <div class="form-group">
            <label class="form-label" for="message">Message *</label>
            <textarea 
              id="message" 
              name="message" 
              rows="5" 
              class="form-control" 
              placeholder="Describe your question or concern in detail..." 
              required
            ><%= typeof message !== 'undefined' ? message : '' %></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-block btn-lg">
            <i class="fa-solid fa-paper-plane"></i> Submit Inquiry
          </button>
        </form>
      </div>

    </div>

  </div>
</main>

<%- include('../partials/footer') %>
