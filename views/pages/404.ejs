<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container" style="padding-top: 4rem; padding-bottom: 6rem;">
  <div style="max-width: 580px; margin: 0 auto; text-align: center;">
    
    <div style="font-size: 6rem; font-weight: 900; line-height: 1; color: var(--primary); margin-bottom: 1rem; letter-spacing: -0.04em;">
      404
    </div>

    <h1 style="font-size: 2rem; font-weight: 800; color: var(--secondary); margin-bottom: 0.75rem;">
      Page or Resource Not Found
    </h1>

    <p style="font-size: 1.05rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 2rem;">
      <%= typeof customMessage !== 'undefined' ? customMessage : 'The page you were searching for does not exist, has been moved, or is temporarily unavailable.' %>
    </p>

    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
      <a href="/" class="btn btn-primary btn-lg">
        <i class="fa-solid fa-house"></i> Return Home
      </a>
      <a href="/products" class="btn btn-outline btn-lg">
        <i class="fa-solid fa-bag-shopping"></i> Explore Products
      </a>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
