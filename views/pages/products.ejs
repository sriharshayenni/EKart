<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container" style="padding-top: 1.5rem; padding-bottom: 3rem;">

  <!-- Breadcrumb -->
  <div style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
    <a href="/" style="color: var(--primary);">Home</a>
    <span>/</span>
    <span style="color: var(--secondary); font-weight: 500;">
      <%= selectedCategory ? selectedCategory.name : (query.search ? `Search: "${query.search}"` : 'All Products') %>
    </span>
  </div>

  <!-- Mobile Filter Toggle Button -->
  <div style="display: none; margin-bottom: 1rem;" class="mobile-filter-btn">
    <button class="btn btn-primary btn-block">
      <i class="fa-solid fa-filter"></i> Filters &amp; Sorting
    </button>
  </div>

  <div class="catalog-layout" style="display: grid; grid-template-columns: 280px 1fr; gap: 2rem; align-items: start;">
    
    <!-- Filter Sidebar -->
    <aside class="filter-sidebar card" style="padding: 1.5rem;">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem;">
        <h3 style="font-size: 1.125rem; font-weight: 700; color: var(--secondary);">Filters</h3>
        <a href="/products" style="font-size: 0.8125rem; color: var(--accent-rose); font-weight: 600;">Clear All</a>
      </div>

      <form action="/products" method="GET" id="filter-form">
        <!-- Preserve existing search if present -->
        <% if (query.search) { %>
          <input type="hidden" name="search" value="<%= query.search %>">
        <% } %>

        <!-- Categories Filter -->
        <div class="form-group" style="border-bottom: 1px solid var(--border-light); padding-bottom: 1.25rem;">
          <label class="form-label">Categories</label>
          <div style="display: flex; flex-direction: column; gap: 0.5rem; max-height: 220px; overflow-y: auto;">
            <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; cursor: pointer;">
              <input 
                type="radio" 
                name="category" 
                value="all" 
                <%= (!query.category || query.category === 'all') ? 'checked' : '' %>
                onchange="this.form.submit()"
              >
              All Categories
            </label>
            <% categories.forEach(cat => { %>
              <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; cursor: pointer;">
                <input 
                  type="radio" 
                  name="category" 
                  value="<%= cat.slug %>" 
                  <%= (query.category === cat.slug) ? 'checked' : '' %>
                  onchange="this.form.submit()"
                >
                <%= cat.name %>
              </label>
            <% }) %>
          </div>
        </div>

        <!-- Price Range Filter -->
        <div class="form-group" style="border-bottom: 1px solid var(--border-light); padding-bottom: 1.25rem;">
          <label class="form-label">Price Range (₹)</label>
          <div style="display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.75rem;">
            <input 
              type="number" 
              name="minPrice" 
              placeholder="Min" 
              class="form-control" 
              style="padding: 0.4rem 0.6rem; font-size: 0.85rem;"
              value="<%= query.minPrice || '' %>"
            >
            <span style="color: var(--text-muted);">-</span>
            <input 
              type="number" 
              name="maxPrice" 
              placeholder="Max" 
              class="form-control" 
              style="padding: 0.4rem 0.6rem; font-size: 0.85rem;"
              value="<%= query.maxPrice || '' %>"
            >
          </div>
          <button type="submit" class="btn btn-outline btn-sm btn-block">Apply Price</button>
        </div>

        <!-- Availability Filter -->
        <div class="form-group" style="border-bottom: 1px solid var(--border-light); padding-bottom: 1.25rem;">
          <label class="form-label">Availability</label>
          <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; cursor: pointer;">
            <input 
              type="checkbox" 
              name="inStock" 
              value="true" 
              <%= (query.inStock === 'true') ? 'checked' : '' %>
              onchange="this.form.submit()"
            >
            In Stock Only
          </label>
        </div>

        <!-- Rating Filter -->
        <div class="form-group" style="border-bottom: 1px solid var(--border-light); padding-bottom: 1.25rem;">
          <label class="form-label">Customer Rating</label>
          <div style="display: flex; flex-direction: column; gap: 0.5rem;">
            <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; cursor: pointer;">
              <input 
                type="radio" 
                name="rating" 
                value="4" 
                <%= (query.rating === '4') ? 'checked' : '' %>
                onchange="this.form.submit()"
              >
              <span style="color: var(--accent-amber);">★★★★☆</span> &amp; Up
            </label>
            <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; cursor: pointer;">
              <input 
                type="radio" 
                name="rating" 
                value="3" 
                <%= (query.rating === '3') ? 'checked' : '' %>
                onchange="this.form.submit()"
              >
              <span style="color: var(--accent-amber);">★★★☆☆</span> &amp; Up
            </label>
          </div>
        </div>

        <!-- Preserved Sort in form -->
        <% if (query.sort) { %>
          <input type="hidden" name="sort" value="<%= query.sort %>">
        <% } %>

        <div style="margin-top: 1rem;">
          <button type="submit" class="btn btn-primary btn-block">
            Apply Filters
          </button>
        </div>
      </form>
    </aside>

    <!-- Products Results Column -->
    <section>
      <!-- Controls Topbar -->
      <div style="background: white; border: 1px solid var(--border-light); border-radius: var(--radius-md); padding: 0.85rem 1.25rem; display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
        <div>
          <span style="font-weight: 700; color: var(--secondary);"><%= totalProducts %></span> products found
          <% if (query.search) { %>
            for "<span style="color: var(--primary);"><%= query.search %></span>"
          <% } %>
        </div>

        <!-- Sort Selection -->
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <label for="sort-select" style="font-size: 0.875rem; color: var(--text-muted); font-weight: 500;">Sort by:</label>
          <select 
            id="sort-select" 
            class="form-control" 
            style="width: auto; padding: 0.35rem 0.85rem; font-size: 0.875rem;"
            onchange="const url = new URL(window.location.href); url.searchParams.set('sort', this.value); url.searchParams.set('page', '1'); window.location.href = url.toString();"
          >
            <option value="newest" <%= (!query.sort || query.sort === 'newest') ? 'selected' : '' %>>Newest Arrivals</option>
            <option value="price_asc" <%= (query.sort === 'price_asc') ? 'selected' : '' %>>Price: Low to High</option>
            <option value="price_desc" <%= (query.sort === 'price_desc') ? 'selected' : '' %>>Price: High to Low</option>
            <option value="rating" <%= (query.sort === 'rating') ? 'selected' : '' %>>Customer Rating</option>
            <option value="popular" <%= (query.sort === 'popular') ? 'selected' : '' %>>Most Popular</option>
            <option value="discount" <%= (query.sort === 'discount') ? 'selected' : '' %>>Biggest Discount</option>
          </select>
        </div>
      </div>

      <!-- Products Grid -->
      <% if (products.length > 0) { %>
        <div class="products-grid">
          <% products.forEach(product => { %>
            <%- include('../partials/product-card', { product: product }) %>
          <% }) %>
        </div>

        <!-- Pagination -->
        <% if (totalPages > 1) { %>
          <div class="pagination">
            <% if (currentPage > 1) { %>
              <a href="/products?<%= new URLSearchParams({...query, page: currentPage - 1}).toString() %>" class="page-link" aria-label="Previous Page">
                <i class="fa-solid fa-chevron-left"></i>
              </a>
            <% } %>

            <% for(let p = 1; p <= totalPages; p++) { %>
              <% if (p === 1 || p === totalPages || (p >= currentPage - 2 && p <= currentPage + 2)) { %>
                <a 
                  href="/products?<%= new URLSearchParams({...query, page: p}).toString() %>" 
                  class="page-link <%= p === currentPage ? 'active' : '' %>"
                >
                  <%= p %>
                </a>
              <% } else if (p === currentPage - 3 || p === currentPage + 3) { %>
                <span style="padding: 0 4px; color: var(--text-muted);">&hellip;</span>
              <% } %>
            <% } %>

            <% if (currentPage < totalPages) { %>
              <a href="/products?<%= new URLSearchParams({...query, page: currentPage + 1}).toString() %>" class="page-link" aria-label="Next Page">
                <i class="fa-solid fa-chevron-right"></i>
              </a>
            <% } %>
          </div>
        <% } %>

      <% } else { %>
        <!-- Empty State -->
        <div class="empty-state">
          <div class="empty-icon">
            <i class="fa-solid fa-magnifying-glass"></i>
          </div>
          <h3 class="empty-title">No Matching Products Found</h3>
          <p class="empty-desc">
            We couldn't find any items matching your selected filters or search terms. Try clearing filters or searching with different keywords.
          </p>
          <a href="/products" class="btn btn-primary">
            Clear Filters &amp; View All
          </a>
        </div>
      <% } %>

    </section>

  </div>

</main>

<%- include('../partials/footer') %>
