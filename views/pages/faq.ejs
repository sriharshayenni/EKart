<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container" style="padding-top: 3rem; padding-bottom: 5rem;">
  <div style="max-width: 800px; margin: 0 auto;">
    
    <div style="text-align: center; margin-bottom: 3rem;">
      <h1 style="font-size: 2.25rem; font-weight: 800; color: var(--secondary); margin-bottom: 0.75rem;">
        Frequently Asked Questions
      </h1>
      <p style="font-size: 1.05rem; color: var(--text-muted);">
        Find quick answers to common questions about orders, payments, shipping, and refunds.
      </p>
    </div>

    <div style="display: flex; flex-direction: column; gap: 1.25rem;">
      <div class="card" style="padding: 1.5rem;">
        <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--secondary); margin-bottom: 0.5rem;">
          How long does delivery take?
        </h3>
        <p style="color: var(--text-muted); line-height: 1.6; font-size: 0.9375rem;">
          Most orders are dispatched within 24 hours from our nearest regional warehouse. Standard metropolitan deliveries arrive within 2 to 3 business days, while non-metro locations take 4 to 5 days.
        </p>
      </div>

      <div class="card" style="padding: 1.5rem;">
        <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--secondary); margin-bottom: 0.5rem;">
          What is the 7-Day Return Policy?
        </h3>
        <p style="color: var(--text-muted); line-height: 1.6; font-size: 0.9375rem;">
          If an item arrives damaged, defective, or incorrect, you can request an instant return or replacement within 7 calendar days of delivery directly through your account dashboard or by contacting support.
        </p>
      </div>

      <div class="card" style="padding: 1.5rem;">
        <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--secondary); margin-bottom: 0.5rem;">
          What payment methods are supported?
        </h3>
        <p style="color: var(--text-muted); line-height: 1.6; font-size: 0.9375rem;">
          We support all major Credit and Debit Cards (Visa, MasterCard, RuPay), UPI (Google Pay, PhonePe, Paytm, BHIM), Net Banking across 50+ banks, and Cash on Delivery (COD) for eligible pin codes.
        </p>
      </div>

      <div class="card" style="padding: 1.5rem;">
        <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--secondary); margin-bottom: 0.5rem;">
          How do I cancel my order?
        </h3>
        <p style="color: var(--text-muted); line-height: 1.6; font-size: 0.9375rem;">
          Orders can be cancelled at any time while their status remains "Pending" by visiting your <a href="/orders" style="color: var(--primary); font-weight: 600;">Orders page</a> and clicking the "Cancel Order" button.
        </p>
      </div>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
