<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container" style="padding-top: 2rem; padding-bottom: 4rem;">

  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem;">
    <div>
      <h1 style="font-size: 1.85rem; font-weight: 800; color: var(--secondary);">My Order History</h1>
      <p style="font-size: 0.875rem; color: var(--text-muted);">View, track, and manage all your past eKart orders</p>
    </div>
    <a href="/products" class="btn btn-outline btn-sm">
      <i class="fa-solid fa-bag-shopping"></i> Continue Shopping
    </a>
  </div>

  <% if (orders && orders.length > 0) { %>
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      <% orders.forEach(order => { %>
        <div class="card" style="padding: 1.5rem;">
          <!-- Order Card Header -->
          <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; border-bottom: 1px solid var(--border-light); padding-bottom: 1rem; margin-bottom: 1.25rem;">
            <div>
              <div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); font-weight: 600;">
                Order Number
              </div>
              <div style="font-size: 1.1rem; font-weight: 700; color: var(--secondary);">
                #<%= order.orderNumber %>
              </div>
            </div>

            <div>
              <div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); font-weight: 600;">
                Date Placed
              </div>
              <div style="font-size: 0.9375rem; color: var(--secondary); font-weight: 500;">
                <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
              </div>
            </div>

            <div>
              <div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); font-weight: 600;">
                Total Amount
              </div>
              <div style="font-size: 1.1rem; font-weight: 800; color: var(--primary);">
                ₹<%= order.total.toLocaleString() %>
              </div>
            </div>

            <div>
              <span class="status-badge status-<%= order.status.toLowerCase() %>" style="font-size: 0.85rem; padding: 4px 12px;">
                <%= order.status %>
              </span>
            </div>

            <div>
              <a href="/orders/<%= order._id %>" class="btn btn-primary btn-sm">
                View Order Details <i class="fa-solid fa-chevron-right" style="font-size: 0.7rem;"></i>
              </a>
            </div>
          </div>

          <!-- Items Thumbnail Strip -->
          <div style="display: flex; gap: 1rem; align-items: center; overflow-x: auto; padding-bottom: 0.5rem;">
            <% order.items.forEach(it => { %>
              <div style="display: flex; align-items: center; gap: 0.75rem; background: #f8fafc; border: 1px solid var(--border-light); border-radius: var(--radius-md); padding: 0.5rem 0.75rem; flex-shrink: 0;">
                <img 
                  src="<%= it.image || '/images/placeholder.svg' %>" 
                  alt="<%= it.name %>" 
                  style="width: 2.5rem; height: 2.5rem; object-fit: contain;"
                  onerror="this.onerror=null; this.src='/images/placeholder.svg';"
                >
                <div>
                  <div style="font-size: 0.8125rem; font-weight: 600; color: var(--secondary); max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    <%= it.name %>
                  </div>
                  <div style="font-size: 0.75rem; color: var(--text-muted);">
                    Qty: <%= it.quantity %> &bull; ₹<%= it.price.toLocaleString() %>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <div class="empty-icon">
        <i class="fa-solid fa-box-open"></i>
      </div>
      <h2 class="empty-title">You have not placed any orders yet</h2>
      <p class="empty-desc">
        Explore our curated catalog of smartphones, laptops, fashion, and home appliances to start shopping!
      </p>
      <a href="/products" class="btn btn-primary btn-lg">
        <i class="fa-solid fa-bag-shopping"></i> Browse Products
      </a>
    </div>
  <% } %>

</main>

<%- include('../partials/footer') %>
