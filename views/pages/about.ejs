<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container" style="padding-top: 3rem; padding-bottom: 5rem;">
  <div style="max-width: 800px; margin: 0 auto;">
    
    <div style="text-align: center; margin-bottom: 3rem;">
      <span class="hero-badge" style="background: var(--primary-light); color: var(--primary); border-color: var(--primary-border);">
        Our Story &amp; Vision
      </span>
      <h1 style="font-size: 2.5rem; font-weight: 800; color: var(--secondary); margin-top: 0.75rem; margin-bottom: 1rem;">
        About eKart
      </h1>
      <p style="font-size: 1.1rem; color: var(--text-muted); line-height: 1.6;">
        Bridging high-performance modern commerce with dependable consumer satisfaction, fast delivery, and authentic quality products.
      </p>
    </div>

    <div class="card" style="padding: 2.5rem; line-height: 1.8; color: var(--text-main); margin-bottom: 2rem;">
      <h2 style="font-size: 1.35rem; font-weight: 700; color: var(--secondary); margin-bottom: 0.75rem;">
        Who We Are
      </h2>
      <p style="margin-bottom: 1.5rem;">
        Founded with the goal of creating an effortless, lightning-fast digital marketplace, eKart provides direct access to premier consumer electronics, top lifestyle apparel, smart home gadgets, and everyday essentials.
      </p>

      <h2 style="font-size: 1.35rem; font-weight: 700; color: var(--secondary); margin-bottom: 0.75rem;">
        Our Core Principles
      </h2>
      <ul style="padding-left: 1.5rem; margin-bottom: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem;">
        <li><strong>Authenticity Guaranteed:</strong> Every gadget, phone, fashion piece, and appliance is sourced through authorized supply lines.</li>
        <li><strong>Transparent Pricing:</strong> Clear breakdowns of item prices, taxes, and shipping fees without deceptive markups.</li>
        <li><strong>Speed &amp; Reliability:</strong> Real-time inventory tracking, fast order fulfillment, and dedicated parcel handling.</li>
        <li><strong>Customer-First Support:</strong> Round-the-clock help desk and simplified 7-day return processes.</li>
      </ul>

      <h2 style="font-size: 1.35rem; font-weight: 700; color: var(--secondary); margin-bottom: 0.75rem;">
        Technology Architecture
      </h2>
      <p>
        Built completely on Node.js, Express.js, MongoDB, Mongoose, and server-side EJS templates with stateful session security. No heavy frontend client bundles, ensuring ultra-fast page speeds, maximum accessibility, and airtight security.
      </p>
    </div>

    <div style="text-align: center;">
      <a href="/products" class="btn btn-primary btn-lg">
        <i class="fa-solid fa-bag-shopping"></i> Start Shopping with eKart
      </a>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
